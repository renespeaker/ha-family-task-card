{
  "name": "ha-family-task-card",
  "version": "0.8.2",
  "description": "Gamified family task / chore card for Home Assistant",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/renespeaker/ha-family-task-card.git"
  },
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c --watch",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:shared": "node tools/check-shared.mjs",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "dependencies": {
    "lit": "^3.1.0"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.3.0",
    "custom-card-helpers": "^2.0.0",
    "happy-dom": "^20.14.5",
    "prettier": "^3.2.5",
    "rollup": "^4.9.0",
    "tslib": "^2.6.2",
    "typescript": "^5.6.3",
    "vitest": "^4.1.11"
  }
}
